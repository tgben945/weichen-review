#!/bin/bash
# 威辰審片站固定網址（Ben 11/25：連結以後固定不變）。https://tgben945.github.io/weichen-review/
# 指定影片：固定網址後面加 #<審片站內路徑>（例 #%E6%AF%9B%E7%89%87/）
# 11/25 13:06 改成直接轉址（內嵌框在手機版面跑掉、影片不能播）到當下的 Cloudflare 快速通道；通道網址變了就重寫 index.html 並推上 GitHub（share-weichen.sh 會呼叫）
R=/Users/ben/.config/tglesgo/weichen-fixed; U=$(cat /Users/ben/.config/tglesgo/share-weichen-url); [ -n "$U" ] || exit 0
cat > $R/index.html <<HTML
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>威辰審片站</title><link rel="icon" href="icon-32.png"><link rel="apple-touch-icon" href="icon-180.png"><meta name="robots" content="noindex">
<script>location.replace("$U"+location.hash.slice(1))</script>
<noscript><meta http-equiv="refresh" content="0;url=$U"></noscript></head>
<body style="font-family:-apple-system,sans-serif;text-align:center;padding:40px;background:#FFF6E5">審片站開啟中… <a href="$U">沒跳轉請點這裡</a></body></html>
HTML
cd $R && git add -A && git -c user.name=tgben945 -c user.email=tgben945@users.noreply.github.com commit -qm "update" && HOME=/Users/ben GH_CONFIG_DIR=/Users/ben/.config/gh git push -q origin main 2>&1 | tail -1
echo ok
